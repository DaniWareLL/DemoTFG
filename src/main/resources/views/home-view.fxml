<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="mainContainer" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sonik.ui.controller.HomeController">
   <left>
      <VBox fx:id="leftContainer" minWidth="230.0" spacing="10.0"
            style="-fx-background-color: #191919; -fx-background-radius: 20;">
         <BorderPane.margin>
            <Insets left="10.0" right="5.0"/>
         </BorderPane.margin>
         <Label text="Discover" textFill="WHITE">
            <font>
               <Font name="Manrope ExtraBold" size="16.0"/>
            </font>
            <VBox.margin>
               <Insets left="15.0" top="15.0"/>
            </VBox.margin>
         </Label>
         <Button fx:id="buttonExplore" mnemonicParsing="false" onMouseClicked="#exploreButtonOnMC"
                 style="-fx-alignment: left; -fx-background-color: #191919;" text="Explore" textFill="WHITE">
            <font>
               <Font name="Manrope Regular" size="16.0"/>
            </font>
            <graphic>
               <FontIcon iconColor="WHITE" iconLiteral="mdi2c-compass-outline" iconSize="25"/>
            </graphic>
            <maxWidth>1.7976931348623157E308</maxWidth>
         </Button>
         <Separator style="-fx-background-color: white; -fx-border-width: 0.1;">
            <VBox.margin>
               <Insets left="12.0" right="12.0"/>
            </VBox.margin>
         </Separator>
         <Label text="Library" textFill="WHITE">
            <font>
               <Font name="Manrope ExtraBold" size="16.0"/>
            </font>
            <VBox.margin>
               <Insets left="15.0"/>
            </VBox.margin>
         </Label>
         <Button fx:id="buttonPlaylist" mnemonicParsing="false" onMouseClicked="#playlistButtonOnMC"
                 style="-fx-alignment: left; -fx-background-color: #191919;" text="Playlist" textFill="WHITE">
            <font>
               <Font name="Manrope Regular" size="16.0"/>
            </font>
            <graphic>
               <FontIcon iconColor="WHITE" iconLiteral="mdi2p-playlist-play" iconSize="25"/>
            </graphic>
            <maxWidth>1.7976931348623157E308</maxWidth>
         </Button>
         <Button fx:id="buttonSongs" mnemonicParsing="false" onMouseClicked="#songButtonOnMC"
                 style="-fx-alignment: left; -fx-background-color: #191919;" text="Songs" textFill="WHITE">
            <font>
               <Font name="Manrope Regular" size="16.0"/>
            </font>
            <graphic>
               <FontIcon iconColor="WHITE" iconLiteral="mdi2m-music-note-outline" iconSize="25"/>
            </graphic>
            <maxWidth>1.7976931348623157E308</maxWidth>
         </Button>
         <Separator style="-fx-background-color: white; -fx-border-width: 0.1;">
            <VBox.margin>
               <Insets left="12.0" right="12.0"/>
            </VBox.margin>
         </Separator>
      </VBox>
   </left>

   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: black;"
                  stylesheets="@../css/scrollpane-fix.css">
         <BorderPane.margin>
            <Insets/>
         </BorderPane.margin>
         <VBox style="-fx-background-color: #191919; -fx-background-radius: 20;">
            <VBox fillWidth="false" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets left="70.0" right="70.0" top="20.0"/>
               </VBox.margin>
               <Label text="Playlists" textFill="WHITE">
                  <font>
                     <Font name="Manrope ExtraBold" size="24.0"/>
                  </font>
               </Label>
               <Label text="Your lists" textFill="#e9b18a">
                  <font>
                     <Font name="Manrope Medium" size="16.0"/>
                  </font>
               </Label>
               <HBox alignment="CENTER_LEFT" spacing="40.0">
                  <VBox.margin>
                     <Insets top="20.0"/>
                  </VBox.margin>
                  <VBox HBox.hgrow="SOMETIMES">
                     <ImageView fitWidth="180.0" preserveRatio="true">
                        <Image url="@../images/Sonik/Playlist.png"/>
                     </ImageView>
                     <Label text="Playlist name" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="18.0"/>
                        </font>
                     </Label>
                     <Label text="Description" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="13.0"/>
                        </font>
                     </Label>
                  </VBox>
                  <VBox HBox.hgrow="SOMETIMES">
                     <ImageView fitWidth="180.0" preserveRatio="true">
                        <Image url="@../images/Sonik/Playlist.png"/>
                     </ImageView>
                     <Label text="Playlist name" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="18.0"/>
                        </font>
                     </Label>
                     <Label text="Description" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="13.0"/>
                        </font>
                     </Label>
                  </VBox>
                  <VBox HBox.hgrow="SOMETIMES">
                     <ImageView fitWidth="180.0" preserveRatio="true">
                        <Image url="@../images/Sonik/Playlist.png"/>
                     </ImageView>
                     <Label text="Playlist name" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="18.0"/>
                        </font>
                     </Label>
                     <Label text="Description" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="13.0"/>
                        </font>
                     </Label>
                  </VBox>
                  <VBox HBox.hgrow="SOMETIMES">
                     <ImageView fitWidth="180.0" preserveRatio="true">
                        <Image url="@../images/Sonik/Playlist.png"/>
                     </ImageView>
                     <Label text="Playlist name" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="18.0"/>
                        </font>
                     </Label>
                     <Label text="Description" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="13.0"/>
                        </font>
                     </Label>
                  </VBox>
               </HBox>
            </VBox>

            <VBox fillWidth="false" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets left="70.0" right="70.0"/>
               </padding>
               <VBox.margin>
                  <Insets/>
               </VBox.margin>
               <Label text="Library" textFill="WHITE">
                  <font>
                     <Font name="Manrope ExtraBold" size="26.0"/>
                  </font>
               </Label>
               <Label text="Your Songs" textFill="#e9b18a">
                  <font>
                     <Font name="Manrope Medium" size="16.0"/>
                  </font>
               </Label>

               <HBox alignment="CENTER_LEFT" spacing="30.0">
                  <VBox.margin>
                     <Insets top="20.0"/>
                  </VBox.margin>
                  <VBox HBox.hgrow="SOMETIMES">
                     <ImageView fitHeight="110.0" fitWidth="110.0" preserveRatio="true">
                        <image>
                           <Image url="@../images/Sonik/Image.png"/>
                        </image>
                     </ImageView>
                     <Label text="Song name" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="16.0"/>
                        </font>
                     </Label>
                  </VBox>
                  <VBox HBox.hgrow="SOMETIMES">
                     <ImageView fitHeight="110.0" fitWidth="110.0" preserveRatio="true">
                        <image>
                           <Image url="@../images/Sonik/Image.png"/>
                        </image>
                     </ImageView>
                     <Label text="Song name" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="13.0"/>
                        </font>
                     </Label>
                  </VBox>
                  <VBox HBox.hgrow="SOMETIMES">
                     <ImageView fitHeight="110.0" fitWidth="110.0" preserveRatio="true">
                        <image>
                           <Image url="@../images/Sonik/Image.png"/>
                        </image>
                     </ImageView>
                     <Label text="Song name" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="13.0"/>
                        </font>
                     </Label>
                  </VBox>
                  <VBox HBox.hgrow="SOMETIMES">
                     <ImageView fitHeight="110.0" fitWidth="110.0" preserveRatio="true">
                        <Image url="@../images/Sonik/Image.png"/>
                     </ImageView>
                     <Label text="Song name" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="13.0"/>
                        </font>
                     </Label>
                  </VBox>
                  <VBox HBox.hgrow="SOMETIMES">
                     <ImageView fitHeight="110.0" fitWidth="110.0" preserveRatio="true">
                        <Image url="@../images/Sonik/Image.png"/>
                     </ImageView>
                     <Label text="Song name" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="13.0"/>
                        </font>
                     </Label>
                  </VBox>
                  <VBox HBox.hgrow="SOMETIMES">
                     <ImageView fitHeight="110.0" fitWidth="110.0" preserveRatio="true">
                        <Image url="@../images/Sonik/Image.png"/>
                     </ImageView>
                     <Label text="Song name" textFill="WHITE">
                        <font>
                           <Font name="Manrope Medium" size="13.0"/>
                        </font>
                     </Label>
                  </VBox>
               </HBox>
            </VBox>
         </VBox>
      </ScrollPane>
   </center>
   <top>
      <HBox alignment="CENTER" stylesheets="@../css/window-buttons.css" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets/>
         </BorderPane.margin>
         <HBox>
            <HBox.margin>
               <Insets left="20.0"/>
            </HBox.margin>
            <ImageView fitHeight="59.0" fitWidth="38.0" preserveRatio="true" smooth="false" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets top="5.0"/>
               </HBox.margin>
               <Image url="@../images/Sonik/IconoSonikColor.png"/>
            </ImageView>
         </HBox>
         <Region HBox.hgrow="ALWAYS"/>
         <Button fx:id="homeBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#homeBtnMC"
                 style="-fx-alignment: center; -fx-background-color: #191919; -fx-background-radius: 20;"
                 textFill="WHITE">
            <font>
               <Font name="Manrope Regular" size="16.0"/>
            </font>
            <graphic>
               <FontIcon iconColor="WHITE" iconLiteral="mdi2h-home-outline" iconSize="25"/>
            </graphic>
         </Button>
         <HBox alignment="CENTER_LEFT" maxHeight="40.0" spacing="8.0"
               style="-fx-background-radius: 20; -fx-background-color: #191919;" HBox.hgrow="ALWAYS">
            <padding>
               <Insets left="5.0"/>
            </padding>
            <HBox.margin>
               <Insets left="15.0"/>
            </HBox.margin>
            <FontIcon iconColor="WHITE" iconLiteral="mdi2m-magnify" iconSize="25"/>
            <TextField fx:id="searchBar" onKeyPressed="#searchBarOnKP" promptText="Search..."
                       style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: none;"
                       HBox.hgrow="ALWAYS">
               <font>
                  <Font name="Manrope ExtraLight" size="15.0"/>
               </font>
               <HBox.margin>
                  <Insets/>
               </HBox.margin>
            </TextField>
         </HBox>
         <Region HBox.hgrow="ALWAYS">
            <HBox.margin>
               <Insets/>
            </HBox.margin>
         </Region>
         <HBox alignment="CENTER" style="-fx-background-radius: 20;">
            <HBox.margin>
               <Insets/>
            </HBox.margin>
            <Button fx:id="buttonOptions" mnemonicParsing="false" style="-fx-background-color: black;"
                    textFill="WHITE">
               <font>
                  <Font name="Manrope Regular" size="16.0"/>
               </font>
               <graphic>
                  <FontIcon fx:id="settingsButton" iconColor="WHITE" iconLiteral="mdi2c-cog-outline" iconSize="25"
                            lineSpacing="200.0" onMouseClicked="#settingButtonMC" text="󰢻"/>
               </graphic>
            </Button>
            <Label fx:id="userNameLabel" contentDisplay="CENTER" text="Username" textFill="WHITE">
               <font>
                  <Font name="Manrope Regular" size="16.0"/>
               </font>
               <HBox.margin>
                  <Insets right="30.0"/>
               </HBox.margin>
            </Label>
         </HBox>
         <HBox fx:id="windowButtons" alignment="CENTER_RIGHT" stylesheets="@../css/window-buttons.css"
               HBox.hgrow="NEVER">
            <Button fx:id="minBtn" minHeight="38.0" minWidth="56.0" mnemonicParsing="false"
                    style="-fx-background-color: transparent;" styleClass="window-btn min" textFill="WHITE"
                    HBox.hgrow="ALWAYS">
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="mdi2w-window-minimize" iconSize="18"/>
               </graphic>
               <HBox.margin>
                  <Insets/>
               </HBox.margin>
            </Button>
            <Button fx:id="maxBtn" minHeight="38.0" minWidth="56.0" mnemonicParsing="false"
                    style="-fx-background-color: transparent;" styleClass="window-btn max" textFill="WHITE"
                    HBox.hgrow="ALWAYS">
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="mdi2w-window-maximize" iconSize="18"/>
               </graphic>
            </Button>
            <Button fx:id="closeBtn" minHeight="38.0" minWidth="56.0" mnemonicParsing="false"
                    style="-fx-background-color: transparent;" styleClass="window-btn close" textFill="WHITE"
                    HBox.hgrow="ALWAYS">
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="mdi2c-close" iconSize="18" text="󰅖"/>
               </graphic>
            </Button>
         </HBox>
      </HBox>
   </top>
</BorderPane>
