<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxWidth="260.0" minWidth="200.0" prefWidth="230.0" spacing="10.0" style="-fx-background-color: #191919; -fx-background-radius: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sonik.ui.controller.PlaylistSidebarController">
   <children>
      <Label text="Your Playlists" textFill="WHITE">
         <font>
            <Font name="Manrope ExtraBold" size="24.0" />
         </font>
         <VBox.margin>
            <Insets left="15.0" top="15.0" />
         </VBox.margin>
      </Label>
      <VBox style="-fx-background-color: black; -fx-padding: 0; -fx-spacing: 0;">
         <children>
            <ListView fx:id="playlistListView" style="-fx-background-color: black;  -fx-control-inner-background: black; -fx-background-insets: 0; -fx-padding: 0;" stylesheets="@../css/playlist-sidebar.css" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#createPlaylistOnMC" style="-fx-alignment: left; -fx-background-color: #191919;" text="New Playlist" textFill="WHITE">
               <font>
                  <Font name="Manrope Regular" size="16.0" />
               </font>
            </Button>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#deletePlaylistOnMC" style="-fx-alignment: left; -fx-background-color: #191919;" text="Delete Playlist" textFill="WHITE">
               <font>
                  <Font name="Manrope Regular" size="16.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets left="10.0" />
         </padding>
      </VBox>
   </children>
</VBox>
