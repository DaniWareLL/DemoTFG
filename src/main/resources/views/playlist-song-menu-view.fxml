<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10" style="-fx-background-color: #1f1f1f; -fx-padding: 10; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, black, 20, 0.3, 0, 4);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sonik.ui.controller.PlaylistSongMenuController">
   <children>
      <Button mnemonicParsing="false" onAction="#removePlaylistOnAction" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
         <graphic>
            <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="Remove from playlist">
               <font>
                  <Font name="Manrope Medium" size="12.0" />
               </font>
            </Label>
         </graphic>
      </Button>
      <Button mnemonicParsing="false" onAction="#downloadOnAction" style="-fx-background-color: transparent;">
         <graphic>
            <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="Download">
               <font>
                  <Font name="Manrope Medium" size="12.0" />
               </font>
            </Label>
         </graphic>
      </Button>
   </children>
</VBox>
