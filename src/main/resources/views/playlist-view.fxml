<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sonik.ui.controller.SettingsController">
   <content>
      <AnchorPane style="-fx-background-color: black;">
      
         <!-- PANEL PRINCIPAL RESPONSIVE -->
         <VBox alignment="TOP_LEFT" spacing="30" style="-fx-background-color: #191919; -fx-background-radius: 20;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0">
      
            <padding>
               <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
            </padding>
            <children>
               <HBox prefHeight="100.0" prefWidth="200.0">
                  <children>
                     <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../images/Sonik/Playlist.png" />
                        </image>
                     </ImageView>
                     <VBox>
                        <children>
                           <Label text="Playlist 1" textFill="WHITE">
                              <font>
                                 <Font name="Manrope Regular" size="28.0" />
                              </font>
                           </Label>
                           <Label text="Playlist 1" textFill="WHITE">
                              <font>
                                 <Font name="Manrope Regular" size="12.0" />
                              </font>
                           </Label>
                        </children>
                     </VBox>
                  </children>
               </HBox>
            </children>
      
         </VBox>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      
      </AnchorPane>
   </content>
</ScrollPane>
