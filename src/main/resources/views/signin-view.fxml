         <BorderPane.margin>
            <Insets bottom="40.0" left="10.0" top="40.0" />
         </BorderPane.margin>
      </HBox>
   </left>
   <right>
      <HBox alignment="CENTER" minWidth="450.0" BorderPane.alignment="CENTER">
