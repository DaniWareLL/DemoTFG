                              <VBox alignment="CENTER">
                                 <children>
                                    <Button fx:id="signInButton" mnemonicParsing="false" onMouseClicked="#SignInButton_MouseClicked" prefHeight="0.0" prefWidth="91.0" style="-fx-background-color: transparent; -fx-background-radius: 20px; -fx-border-color: white; -fx-border-radius: 20px;" text="Sign in">
                                       <font>
                                          <Font name="Manrope Medium" size="16.0" />
                                       </font>
                                       <textFill>
                                          <LinearGradient endX="1.0" endY="1.0">
                                             <stops>
                                                <Stop>
                                                   <color>
                                                      <Color red="0.7764706015586853" green="0.4000000059604645" blue="0.1921568661928177" />
                                                   </color>
                                                </Stop>
                                                <Stop offset="0.006711409395973154">
                                                   <color>
                                                      <Color red="0.7764706015586853" green="0.4000000059604645" blue="0.1921568661928177" />
                                                   </color>
                                                </Stop>
                                                <Stop offset="1.0">
                                                   <color>
                                                      <Color red="1.0" green="1.0" blue="1.0" />
                                                   </color>
                                                </Stop>
                                             </stops>
                                          </LinearGradient>
                                       </textFill>
                                    </Button>
                                 </children>
                              </VBox>
                              <HBox alignment="CENTER" spacing="5.0">
                                 <children>
                                    <Label text="Don't have an account?">
                                       <font>
                                          <Font name="Manrope ExtraBold" size="14.0" />
                                       </font>
                                       <textFill>
                                          <LinearGradient endX="1.0" endY="1.0">
                                             <stops>
                                                <Stop>
                                                   <color>
                                                      <Color red="0.7764706015586853" green="0.4000000059604645" blue="0.1921568661928177" />
                                                   </color>
                                                </Stop>
                                                <Stop offset="0.006711409395973154">
                                                   <color>
                                                      <Color red="0.7764706015586853" green="0.4000000059604645" blue="0.1921568661928177" />
                                                   </color>
                                                </Stop>
                                                <Stop offset="1.0">
                                                   <color>
                                                      <Color red="1.0" green="1.0" blue="1.0" />
                                                   </color>
                                                </Stop>
                                             </stops>
                                          </LinearGradient>
                                       </textFill>
                                    </Label>
                                    <Button fx:id="signInButton1" mnemonicParsing="false" onMouseClicked="#SignUpButton_MouseClicked" style="-fx-background-color: transparent;" text="Sign up" textFill="#c96b34">
