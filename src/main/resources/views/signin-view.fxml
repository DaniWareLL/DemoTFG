            <AnchorPane fx:id="leftPane" minWidth="450.0" opacity="0.75" style="-fx-background-size: cover; -fx-background-color: #191919; -fx-background-radius: 20;" HBox.hgrow="ALWAYS">
      
            <children>
                  <HBox alignment="CENTER" minWidth="450.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <VBox spacing="20.0">
                           <children>
                              <VBox alignment="CENTER">
                                 <children>
                                    <ImageView fitHeight="85.0" fitWidth="55.0">
